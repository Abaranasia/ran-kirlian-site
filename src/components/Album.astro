---
import type { CollectionEntry } from "astro:content";
import AlbumCover from "@components/AlbumCover.astro";
import { displayTitle, releaseTypeLabels } from "@utils/releases";

interface Props {
  album: CollectionEntry<"albums">;
  // Disable when the same album appears twice on a page: transition names must be unique.
  transition?: boolean;
}

const { album, transition = true } = Astro.props;
const frontmatter = album.data;
const title = displayTitle(album);
---
<a
  href={`/albums/${album.id}/`}
  class="group flex flex-col gap-3 rounded-md text-ink hover:text-ink hover:no-underline"
>
  <AlbumCover
    album={album}
    alt={title}
    width={400}
    quality="low"
    transitionName={transition ? `${album.id}-image` : undefined}
    class="transition-opacity group-hover:opacity-80"
  />
  <span class="flex flex-col gap-1">
    <span class="font-display text-base leading-snug group-hover:text-accent-hover lg:text-lg">{title}</span>
    <span class="text-sm text-muted">{frontmatter.year} &middot; {releaseTypeLabels[frontmatter.type]}</span>
  </span>
</a>
