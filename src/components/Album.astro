---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  album: CollectionEntry<"albums">;
}

const { album } = Astro.props;
const frontmatter = album.data;
---
<div class="lg:flex">
    
    <div class="flex flex-col justify-between py-6 lg:mx-6">
      <a
        href={`/albums/${album.id}`}
        class="group flex flex-col hover:no-underline"
      >
        <Image
          class="w-full h-64 object-cover rounded-lg transition-opacity group-hover:opacity-80"
          src={frontmatter.image}
          alt={frontmatter.title}
          width={400}
          height={400}
          quality="low"
          loading="lazy"
          transition:name={`${album.id}-image`}
        />
        <span class="text-lg group-hover:underline text-white text-center my-3">
          {frontmatter.title}
        </span>
      </a>

      <span class="text-sm text-gray-300">
        
      </span>
    </div>
  </div>
