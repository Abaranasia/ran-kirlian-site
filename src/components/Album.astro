---
import { Image } from "astro:assets";
import { displayTitle } from "@utils/releases";
import type { CollectionEntry } from "astro:content";

interface Props {
  album: CollectionEntry<"albums">;
  // Disable when the same album appears twice on a page: transition names must be unique.
  transition?: boolean;
}

const { album, transition = true } = Astro.props;
const frontmatter = album.data;
---
<div class="lg:flex">
    
    <div class="flex flex-col justify-between py-6">
      <a
        href={`/albums/${album.id}`}
        class="group flex flex-col hover:no-underline"
      >
        <Image
          class="w-full aspect-square object-cover rounded-lg transition-opacity group-hover:opacity-80"
          src={frontmatter.image}
          alt={displayTitle(album)}
          width={400}
          height={400}
          quality="low"
          loading="lazy"
          transition:name={transition ? `${album.id}-image` : undefined}
        />
        <span class="text-base group-hover:underline text-white text-center mt-3">
          {displayTitle(album)}
        </span>
        <span class="text-sm text-gray-400 text-center mt-1">
          {frontmatter.year}
        </span>
      </a>
    </div>
  </div>
