---
import type { CollectionEntry } from "astro:content";
import Album from "@components/Album.astro";

interface Props {
  albums: CollectionEntry<"albums">[];
}

const { albums } = Astro.props;
---
<ul class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
  {albums.map((album) => (
    <li class="list-none ml-0 pl-0">
      <Album album={album} />
    </li>
  ))}
</ul>
