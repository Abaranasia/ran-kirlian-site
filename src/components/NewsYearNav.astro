---
interface Props {
  years: number[];
  // Year whose archive is being shown; undefined on the latest news page.
  current?: number;
}

const { years, current } = Astro.props;
const links = [
  { href: "/news/", label: "Latest", active: current === undefined },
  ...years.map((year) => ({ href: `/news/${year}/`, label: String(year), active: current === year })),
];
---
<nav aria-labelledby="news-archive" class="mt-12 border-t border-hairline pt-8">
  <h2 id="news-archive" class="mt-0 mb-5 text-xl lg:text-2xl">Archive</h2>
  <ul class="flex flex-wrap gap-2">
    {links.map((link) => (
      <li class="list-none ml-0 pl-0">
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class:list={["pill tabular-nums", link.active ? "pill-active" : "pill-outline"]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
