---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { productionDate } from "@utils/productions";

interface Props {
  productions: CollectionEntry<"productions">[];
}

const { productions } = Astro.props;
---
<ol class="m-0 border-t border-hairline p-0">
  {productions.map((production) => {
    const { data } = production;
    const date = productionDate(production);
    return (
      <li class="ml-0 flex list-none items-center gap-4 border-b border-hairline py-4 pl-0 sm:gap-6">
        {/* Duplicates the title link for pointer users; hidden from keyboard and screen readers. */}
        <a
          href={data.url}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
          class="ml-2 shrink-0 rounded-md transition-opacity hover:opacity-80 sm:ml-3"
        >
          <Image
            class="block size-20 rounded-md object-cover sm:size-24"
            src={data.cover}
            alt=""
            width={192}
            height={192}
            quality="mid"
            loading="lazy"
          />
        </a>
        <div class="min-w-0">
          <p class="my-0 font-display text-lg leading-snug text-ink">
            <a href={data.url} target="_blank" rel="noopener noreferrer">
              {data.title}<span class="sr-only"> (external site)</span>
            </a>
          </p>
          <p class="mt-1 mb-0 leading-snug">{data.artist}</p>
          <p class="mt-1 mb-0 leading-snug text-muted">{data.credit}</p>
          <p class="mt-1 mb-0 text-xs tracking-[0.16em] text-muted uppercase">
            {data.label} &middot; <time datetime={date.datetime}>{date.label}</time>
          </p>
        </div>
      </li>
    );
  })}
</ol>
