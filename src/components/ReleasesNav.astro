---
import { getCollection } from "astro:content";
import { releaseCategories } from "@config/release-categories";

interface Props {
  // Active category slug; undefined means "All releases".
  current?: string;
}

const { current } = Astro.props;
const albums = await getCollection("albums");

const links = [
  { href: "/releases/", label: "All releases", count: albums.length, active: current === undefined },
  ...releaseCategories.map((category) => ({
    href: `/releases/${category.slug}/`,
    label: category.label,
    count: albums.filter(category.matches).length,
    active: current === category.slug,
  })),
];
---
<nav aria-label="Release categories">
  <ul class="flex flex-wrap gap-2 md:flex-col md:gap-1">
    {links.map((link) => (
      <li class="list-none ml-0 pl-0">
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class:list={["pill w-full", link.active ? "pill-active" : "pill-quiet"]}
        >
          <span class="flex-1 text-left">{link.label}</span>
          <span class:list={["text-xs tabular-nums", link.active ? "text-accent" : "text-muted"]}>{link.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
