---
import { getCollection } from "astro:content";
import { releaseCategories } from "@config/release-categories";

interface Props {
  // Active category slug, "compilations" or "productions"; undefined means "All releases".
  current?: string;
}

const { current } = Astro.props;
const albums = await getCollection("albums");
const compilations = await getCollection("compilations");
const productions = await getCollection("productions");

const links = [
  { href: "/releases/", label: "All releases", count: albums.length, active: current === undefined, separated: false },
  ...releaseCategories.map((category) => ({
    href: `/releases/${category.slug}/`,
    label: category.label,
    count: albums.filter(category.matches).length,
    active: current === category.slug,
    separated: false,
  })),
  // Compilations and productions are not releases, so they sit apart from the release categories.
  {
    href: "/releases/compilations/",
    label: "Compilations",
    count: compilations.length,
    active: current === "compilations",
    separated: true,
  },
  {
    href: "/releases/productions/",
    label: "Production & Mastering",
    count: productions.length,
    active: current === "productions",
    separated: false,
  },
];
---
<!-- Below md the pills form one horizontally scrollable row that bleeds to the screen edges;
     the vertical padding keeps focus outlines inside the scroller. -->
<nav aria-label="Release categories" class="-mx-4 sm:-mx-6 md:mx-0">
  <ul
    data-releases-nav
    class="releases-nav flex snap-x scroll-px-4 gap-2 overflow-x-auto px-4 py-1 sm:scroll-px-6 sm:px-6 md:flex-col md:gap-1 md:overflow-visible md:p-0"
  >
    {links.map((link) => (
      <li class:list={["list-none ml-0 pl-0 shrink-0 snap-start", link.separated && "md:mt-2 md:border-t md:border-hairline md:pt-3"]}>
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class:list={["pill w-full whitespace-nowrap md:whitespace-normal", link.active ? "pill-active" : "pill-quiet"]}
        >
          <span class="flex-1 text-left">{link.label}</span>
          <span class:list={["text-xs tabular-nums", link.active ? "text-accent" : "text-muted"]}>{link.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* The cut-off pill at the edge already signals the scroller, so its scrollbar is hidden. */
  .releases-nav {
    scrollbar-width: none;
  }

  .releases-nav::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // On narrow screens the active pill can start off-screen, so scroll it into view.
  const revealActivePill = () => {
    const nav = document.querySelector<HTMLElement>("[data-releases-nav]");
    const active = nav?.querySelector<HTMLElement>("[aria-current='page']");
    if (!nav || !active || nav.scrollWidth <= nav.clientWidth) return;
    const navBox = nav.getBoundingClientRect();
    const pillBox = active.getBoundingClientRect();
    // Center the active pill within the scroller.
    nav.scrollLeft += pillBox.left - navBox.left - (navBox.width - pillBox.width) / 2;
  };

  document.addEventListener("astro:page-load", revealActivePill);
</script>
