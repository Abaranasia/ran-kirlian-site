---
import { getCollection } from "astro:content";
import { releaseCategories } from "@config/release-categories";

interface Props {
  // Active category slug; undefined means "All releases".
  current?: string;
}

const { current } = Astro.props;
const albums = await getCollection("albums");

const links = [
  { href: "/", label: "All releases", count: albums.length, active: current === undefined },
  ...releaseCategories.map((category) => ({
    href: `/releases/${category.slug}`,
    label: category.label,
    count: albums.filter(category.matches).length,
    active: current === category.slug,
  })),
];
---
<nav aria-label="Release categories">
  <ul class="flex flex-wrap gap-2 md:flex-col md:gap-1">
    {links.map((link) => (
      <li class="list-none ml-0 pl-0 not-italic">
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class:list={[
            "flex items-center justify-between gap-3 rounded-md px-3 py-2 text-sm hover:no-underline",
            link.active
              ? "bg-gray-700 text-white font-semibold"
              : "text-gray-300 hover:bg-gray-800 hover:text-white",
          ]}
        >
          <span>{link.label}</span>
          <span class="text-xs text-gray-400">{link.count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
