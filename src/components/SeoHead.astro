---
import type { ImageMetadata } from "astro";
import { siteConfig } from "@config/site-config";
import { toOgImage } from "@utils/og-image";
import { getProfile } from "@utils/profile";
import { jsonLdDocument, serializeJsonLd, type JsonLd } from "@utils/seo";

export type PageType = "website" | "music.album" | "article" | "profile";

export interface Props {
  title: string;
  description: string;
  // Social preview image; defaults to the profile photo.
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: PageType;
  noindex?: boolean;
  jsonLd?: JsonLd | JsonLd[];
}

const { title, description, image, imageAlt, type = "website", noindex = false, jsonLd } = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error("`site` must be set in astro.config.mjs to build absolute SEO URLs");
}

const canonical = new URL(Astro.url.pathname, site).href;

const profile = await getProfile();
const previewSource = image ?? profile.data.photo;
const preview = previewSource ? await toOgImage(previewSource, site) : undefined;
const previewAlt = image ? imageAlt ?? title : `Portrait of ${profile.data.name}`;
---
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta name="theme-color" content={siteConfig.themeColor}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<meta property="og:site_name" content={siteConfig.title}>
<meta property="og:locale" content={siteConfig.locale}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
{preview && (
  <>
    <meta property="og:image" content={preview.url}>
    {preview.width && <meta property="og:image:width" content={String(preview.width)}>}
    {preview.height && <meta property="og:image:height" content={String(preview.height)}>}
    <meta property="og:image:alt" content={previewAlt}>
  </>
)}

<meta name="twitter:card" content={preview ? "summary_large_image" : "summary"}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{preview && (
  <>
    <meta name="twitter:image" content={preview.url}>
    <meta name="twitter:image:alt" content={previewAlt}>
  </>
)}

{jsonLd && (
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLdDocument(jsonLd))} />
)}
