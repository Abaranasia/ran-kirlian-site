---
import { getEntry } from "astro:content";
import SocialLinks from "@components/SocialLinks.astro";

const profile = await getEntry("profile", "ran-kirlian");
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-gray-700 pt-6 pb-10 text-sm text-gray-400">
  {profile && (
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <nav aria-label="Social media">
        <SocialLinks socials={profile.data.socials} />
      </nav>
      <a href={`mailto:${profile.data.email}`}>{profile.data.email}</a>
    </div>
  )}
  <p class="text-gray-400 my-4">&copy; {year} {profile?.data.name ?? "Ran Kirlian"}. All rights reserved.</p>
</footer>
