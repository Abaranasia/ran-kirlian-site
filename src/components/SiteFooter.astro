---
import { getEntry } from "astro:content";
import SocialLinks from "@components/SocialLinks.astro";

const profile = await getEntry("profile", "ran-kirlian");
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-gray-700 pt-6 pb-10 text-center text-sm text-gray-400">
  {profile && (
    <section id="contact" aria-labelledby="footer-contact">
      <h2 id="footer-contact">Contact</h2>
      <p class="text-gray-300">You can follow or contact me on these platforms</p>
      <nav aria-label="Social media">
        <SocialLinks socials={profile.data.socials} email={profile.data.email} class="justify-center" />
      </nav>
    </section>
  )}
  <p class="text-gray-400 my-4">&copy; {year} {profile?.data.name ?? "Ran Kirlian"}. All rights reserved.</p>
</footer>
