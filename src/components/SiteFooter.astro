---
import SocialLinks from "@components/SocialLinks.astro";
import { getProfile } from "@utils/profile";

const profile = await getProfile();
const year = new Date().getFullYear();
---
<footer class="mt-20 flex flex-col items-center gap-4 border-t border-hairline pt-12 pb-16 text-center">
  <section id="contact" aria-labelledby="footer-contact" class="flex scroll-mt-6 flex-col items-center gap-4">
    <h2 id="footer-contact" class="my-0 text-xl lg:text-2xl">Contact</h2>
    <p class="my-0 text-muted">You can follow or contact me on these platforms</p>
    <nav aria-label="Social media">
      <SocialLinks socials={profile.data.socials} email={profile.data.email} class="justify-center" />
    </nav>
  </section>
  <p class="my-0 text-sm text-muted">&copy; {year} {profile.data.name}. All rights reserved.</p>
</footer>
