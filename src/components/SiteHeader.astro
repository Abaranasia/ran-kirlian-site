---
import { getEntry } from "astro:content";
import { siteConfig } from "@config/site-config";
import { isActiveNavItem, mainNavigation } from "@config/navigation";

const profile = await getEntry("profile", "ran-kirlian");
const items = mainNavigation(profile?.data.bandcampUrl ?? "https://rankirlian.bandcamp.com");
const { pathname } = Astro.url;
---
<header class="flex flex-col gap-4 py-6 md:flex-row md:items-center md:justify-between md:py-7">
  <a
    href="/"
    class="inline-flex min-h-11 items-center self-start font-display text-xl font-medium tracking-[0.2em] text-ink uppercase hover:text-ink hover:no-underline md:self-auto"
  >
    {siteConfig.title}
  </a>
  <nav aria-label="Main">
    <ul class="flex flex-wrap gap-1 sm:gap-2">
      {items.map((item) => (
        <li class="list-none ml-0 pl-0">
          {item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="pill pill-accent">
              {item.label}
            </a>
          ) : (
            <a
              href={item.href}
              aria-current={isActiveNavItem(item, pathname) ? "page" : undefined}
              class:list={["pill", isActiveNavItem(item, pathname) ? "pill-active" : "pill-quiet"]}
            >
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>
