---
import { getEntry } from "astro:content";
import { siteConfig } from "@config/site-config";
import { isActiveNavItem, mainNavigation } from "@config/navigation";

const profile = await getEntry("profile", "ran-kirlian");
const items = mainNavigation(profile?.data.bandcampUrl ?? "https://rankirlian.bandcamp.com");
const { pathname } = Astro.url;
---
<header class="mb-8 flex flex-col gap-4 border-b border-gray-700 pb-4 md:flex-row md:items-center md:justify-between">
  <a href="/" class="text-2xl font-semibold text-white hover:no-underline">
    {siteConfig.title}
  </a>
  <nav aria-label="Main">
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {items.map((item) => (
        <li class="list-none ml-0 pl-0 not-italic">
          {item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white">
              {item.label}
            </a>
          ) : (
            <a
              href={item.href}
              aria-current={isActiveNavItem(item, pathname) ? "page" : undefined}
              class:list={[
                isActiveNavItem(item, pathname)
                  ? "text-white font-semibold underline underline-offset-4"
                  : "text-gray-300 hover:text-white",
              ]}
            >
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>
