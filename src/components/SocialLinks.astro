---
import { getSocialIcon } from "@config/social-icons";

interface Props {
  socials: { name: string; url: string }[];
  email?: string;
  class?: string;
}

const { socials, email, class: className } = Astro.props;

// Generic envelope outline (24x24), not tied to any mail provider brand.
const EMAIL_ICON_PATH = "M2 5h20v14H2V5zm2 2v.5l8 5 8-5V7H4zm16 2.85-8 5-8-5V17h16V9.85z";
const linkClass = "inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-accent hover:no-underline";
---
<ul class:list={["flex flex-wrap items-center gap-x-3 gap-y-2", className]}>
  {socials.map((social) => {
    const icon = getSocialIcon(social.name);
    return (
      <li class="list-none ml-0 pl-0">
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={icon?.label ?? social.name}
          class={linkClass}
        >
          {icon ? (
            <svg class="size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={icon.path} />
            </svg>
          ) : (
            social.name
          )}
        </a>
      </li>
    );
  })}
  {email && (
    <li class="list-none ml-0 pl-0">
      <a href={`mailto:${email}`} aria-label={`Email ${email}`} class={linkClass}>
        <svg class="size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={EMAIL_ICON_PATH} />
        </svg>
      </a>
    </li>
  )}
</ul>
