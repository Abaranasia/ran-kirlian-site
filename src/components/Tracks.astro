---
interface Track {
  title: string;
  length: string;
}

interface Props {
  tracks: Track[];
  // Total running time of the release.
  duration: string;
}

const { tracks, duration } = Astro.props;
---
<section aria-labelledby="album-tracklist" class="rounded-[10px] border border-hairline bg-surface p-6">
  <h2 id="album-tracklist" class="mt-0 mb-4 text-xl lg:text-2xl">Tracklist</h2>
  <ol class="divide-y divide-hairline">
    {tracks.map((track, index) => (
      <li class="list-none ml-0 pl-0 flex items-baseline gap-4 py-3">
        <span class="w-6 shrink-0 text-right text-sm text-muted tabular-nums">{index + 1}</span>
        <span class="flex-1">{track.title}</span>
        <span class="text-sm text-muted tabular-nums">{track.length}</span>
      </li>
    ))}
  </ol>
  <p class="mt-4 mb-0 flex justify-between gap-4 border-t border-hairline-strong pt-4 text-sm">
    <span class="text-muted">Complete set</span>
    <span class="tabular-nums">{duration}</span>
  </p>
</section>
