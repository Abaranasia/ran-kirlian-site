---
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '@config/site-config';
import '../styles/styles.css';

interface Props {
    title?: string;
    description?: string;
    // Wider content area for grid-heavy pages such as release listings.
    wide?: boolean;
}
const { title, description = siteConfig.description, wide = false } = Astro.props;
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    <ClientRouter />
</head>
<body class="bg-gray-900">
    <main class:list={["mb-10 m-auto text-white p-2", wide ? "max-w-7xl" : "max-w-5xl"]}>
        <slot />
    </main>
</body>
</html>
