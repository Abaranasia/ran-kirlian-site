---
import { Image } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import { getProfile } from "@utils/profile";
import { toOgImage } from "@utils/og-image";
import { artistJsonLd, breadcrumbJsonLd, firstSentence, profilePageJsonLd, truncate } from "@utils/seo";

const profile = await getProfile();
const { name, tagline, bio, photo } = profile.data;
const site = Astro.site!;
const jsonLd = [
  profilePageJsonLd(Astro.url.pathname, site),
  artistJsonLd({ profile, site, imageUrl: photo ? (await toOgImage(photo, site)).url : undefined }),
  breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "About", path: Astro.url.pathname }], site),
];
// Blank lines in the bio separate paragraphs.
const paragraphs = bio.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean);
---

<MainLayout
  title={`About | ${name}`}
  description={truncate(firstSentence(bio))}
  type="profile"
  jsonLd={jsonLd}
>
  <p class="eyebrow mt-6 mb-0 lg:mt-10">About</p>
  <h1 class="mt-4 mb-0">{name}</h1>
  <p class="mt-3 text-xl text-muted">{tagline}</p>

  <div class="mt-10 md:grid md:grid-cols-[minmax(0,1fr)_20rem] md:items-start md:gap-12 lg:gap-16">
    <div class="max-w-prose text-lg [&>p:first-child]:mt-0">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {photo && (
      <Image
        class="mt-5 w-full rounded-md border border-hairline md:mt-0"
        src={photo}
        alt={`Portrait of ${name}`}
        width={500}
        quality="high"
      />
    )}
  </div>
</MainLayout>
