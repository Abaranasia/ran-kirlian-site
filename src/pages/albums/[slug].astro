---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { displayTitle } from "@utils/releases";
import { formatDate } from "@utils/dates";
import { sortReviewsByDate } from "@utils/reviews";
import MainLayout from "@layouts/MainLayout.astro";
import Tracks from "@components/Tracks.astro";
import ReviewItem from "@components/ReviewItem.astro";

 export const getStaticPaths = (async () => {
    const MIN_ALBUM_COVER_WIDTH = 500;
    const albums = await getCollection('albums')
    for (const album of albums) {
        if (album.data.image.width <= MIN_ALBUM_COVER_WIDTH) {
            // Some legacy releases only have low-resolution covers; warn instead of failing the build.
            console.warn(`Album "${album.id}" cover should be wider than ${MIN_ALBUM_COVER_WIDTH}px`);
        }
    }
    return albums.map((album) => (
        {
            params: { slug: album.id},
            props: { album: album}
        }
    ))
}) satisfies GetStaticPaths;
const { album }= Astro.props;
const frontmatter = album.data;
const title = displayTitle(album);

const { Content } = await render(album);

const releasedOn = frontmatter.releaseDate ? formatDate(frontmatter.releaseDate) : frontmatter.year;

const reviews = sortReviewsByDate(
    await getCollection("reviews", (review) => review.data.album.id === album.id)
);

---
<MainLayout title={`${title} | Ran Kirlian`} description={`${title} (${frontmatter.year}) by ${frontmatter.author}: tracklist, credits, reviews and where to listen.`}>
    <h1 class="text-3xl text-white pt-5">{title}</h1>
    <a href="/releases">Back</a>
    <div  class="grid grid-cols-1 gap-8 mt-5 md:mt-5 md:grid-cols-2">
        <Image
            class=" rounded-md my-5"
            src={frontmatter.image}
            alt={title}
            width={600}
            height={600}
            quality="high"
            loading="lazy"
            transition:name={`${album.id}-image`}
        />  
        <div>
            
            <Tracks tracks={frontmatter.tracks}/>
            <p class="text-right mt-10">Complete set: {frontmatter.duration}</p>
        </div>
    </div>

    <!-- Album Contents -->
    <p class="text-gray-400">Released {releasedOn}</p>
     <Content />

    <p>
        <a href={frontmatter.bandcampUrl} target="_blank" rel="noopener noreferrer">
            Listen and purchase on Bandcamp
        </a>
    </p>

    {reviews.length > 0 && (
        <section aria-labelledby="album-reviews">
            <h2 id="album-reviews">Reviews</h2>
            {reviews.map((review) => <ReviewItem review={review} showAlbum={false} headingLevel={3} />)}
        </section>
    )}
</MainLayout>
