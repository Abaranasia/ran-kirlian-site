---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import Tracks from "@components/Tracks.astro";

 export const getStaticPaths = (async () => {
    const MIN_ALBUM_COVER_WIDTH = 500;
    const albums = await getCollection('albums')
    for (const album of albums) {
        if (album.data.image.width <= MIN_ALBUM_COVER_WIDTH) {
            throw new Error(`Album "${album.id}" cover should be wider than ${MIN_ALBUM_COVER_WIDTH}px`);
        }
    }
    return albums.map((album) => (
        {
            params: { slug: album.id},
            props: { album: album}
        }
    ))
}) satisfies GetStaticPaths;
const { album }= Astro.props;
const frontmatter = album.data;

const { Content } = await render(album);

---
<MainLayout title={frontmatter.title}>
    <h1 class="text-3xl text-white pt-5">{frontmatter.title}</h1>
    <a href="/">Back</a>
    <div  class="grid grid-cols-1 gap-8 mt-5 md:mt-5 md:grid-cols-2">
        <Image
            class=" rounded-md my-5"
            src={frontmatter.image}
            alt={frontmatter.title}
            width={600}
            height={600}
            quality="high"
            loading="lazy"
            transition:name={`${album.id}-image`}
        />  
        <div>
            
            <Tracks tracks={frontmatter.tracks}/>
            <p class="text-right mt-10">Complete set: {frontmatter.duration}</p>
        </div>
    </div>

    <!-- Album Contents -->
     <Content /> 

    <footer class="my-20 text-center">
        Social media links
    </footer>
</MainLayout>
