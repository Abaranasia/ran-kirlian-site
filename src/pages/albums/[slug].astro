---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { displayTitle, isLowResCover, MIN_ALBUM_COVER_WIDTH, releaseTypeLabels, trackCountLabel } from "@utils/releases";
import { formatDate } from "@utils/dates";
import { sortReviewsByDate } from "@utils/reviews";
import { toOgImage } from "@utils/og-image";
import { albumDescription, albumJsonLd, breadcrumbJsonLd } from "@utils/seo";
import MainLayout from "@layouts/MainLayout.astro";
import Tracks from "@components/Tracks.astro";
import ReviewItem from "@components/ReviewItem.astro";
import AlbumCover from "@components/AlbumCover.astro";
import NebulaBackdrop from "@components/NebulaBackdrop.astro";

 export const getStaticPaths = (async () => {
    const albums = await getCollection('albums')
    for (const album of albums) {
        if (isLowResCover(album)) {
            // Some legacy releases only have low-resolution covers; warn instead of failing the build.
            console.warn(`Album "${album.id}" cover should be wider than ${MIN_ALBUM_COVER_WIDTH}px`);
        }
    }
    return albums.map((album) => (
        {
            params: { slug: album.id},
            props: { album: album}
        }
    ))
}) satisfies GetStaticPaths;
const { album }= Astro.props;
const frontmatter = album.data;
const title = displayTitle(album);

const { Content } = await render(album);

const releasedOn = frontmatter.releaseDate ? formatDate(frontmatter.releaseDate) : frontmatter.year;

const reviews = sortReviewsByDate(
    await getCollection("reviews", (review) => review.data.album.id === album.id)
);

const site = Astro.site!;
const { pathname } = Astro.url;
const jsonLd = [
    albumJsonLd({
        album,
        path: pathname,
        site,
        imageUrl: (await toOgImage(frontmatter.image, site)).url,
        reviews,
    }),
    breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Releases", path: "/releases/" },
        { name: title, path: pathname },
    ], site),
];

---
<MainLayout
    title={`${title} | Ran Kirlian`}
    description={albumDescription(album)}
    image={frontmatter.image}
    imageAlt={`Cover of ${title} by ${frontmatter.author}`}
    type="music.album"
    jsonLd={jsonLd}
>
    <NebulaBackdrop slot="backdrop" image={frontmatter.image} class="h-[52rem] md:h-[40rem]" />

    <a href="/releases/" class="pill pill-quiet -ml-4 mt-2">
        <span aria-hidden="true">&larr;</span> Back to releases
    </a>

    <div class="mt-6 grid items-center gap-10 md:grid-cols-[minmax(0,26rem)_1fr] md:gap-14">
        <AlbumCover
            album={album}
            alt={title}
            width={600}
            quality="high"
            transitionName={`${album.id}-image`}
            class="w-full max-w-[26rem] shadow-[0_30px_80px_rgb(0_0_0/0.6)]"
        />
        <div class="flex flex-col gap-5">
            <p class="eyebrow my-0">{releaseTypeLabels[frontmatter.type]} &middot; {frontmatter.year}</p>
            <h1 class="my-0 text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">{title}</h1>
            <p class="my-0 text-lg text-muted">
                Released {releasedOn} &middot; {trackCountLabel(album)} &middot; {frontmatter.duration}
            </p>
            <div class="mt-2 flex flex-wrap gap-3">
                <a href={frontmatter.bandcampUrl} target="_blank" rel="noopener noreferrer" class="pill pill-solid min-h-12 px-6 text-base">
                    Listen and purchase on Bandcamp<span class="sr-only"> (external site)</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Album Contents -->
    <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
        <div class="max-w-prose [&>*:first-child]:mt-0">
            <Content />
        </div>
        <div>
            <Tracks tracks={frontmatter.tracks} duration={frontmatter.duration} />
        </div>
    </div>

    {reviews.length > 0 && (
        <section aria-labelledby="album-reviews" class="mt-16 border-t border-hairline pt-12">
            <h2 id="album-reviews" class="mt-0">Reviews</h2>
            {reviews.map((review) => <ReviewItem review={review} showAlbum={false} headingLevel={3} />)}
        </section>
    )}
</MainLayout>
