---
import { getEntry } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import SocialLinks from "@components/SocialLinks.astro";

const profile = await getEntry("profile", "ran-kirlian");
if (!profile) {
  throw new Error('Missing profile entry "ran-kirlian" in src/content/profile.json');
}
const { name, email, socials } = profile.data;
---

<MainLayout
  title={`Contact | ${name}`}
  description={`Contact ${name} by email or follow him on social media.`}
>
  <h1>Contact</h1>

  <section aria-labelledby="contact-email">
    <h2 id="contact-email">Email</h2>
    <p><a href={`mailto:${email}`}>{email}</a></p>
  </section>

  <section aria-labelledby="contact-social">
    <h2 id="contact-social">Social media</h2>
    <SocialLinks socials={socials} />
  </section>
</MainLayout>
