---
import { getCollection } from "astro:content";
import ReleasesLayout from "@components/ReleasesLayout.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { siteConfig } from "@config/site-config";
import { sortByReleaseDate } from "@utils/releases";

const albums = sortByReleaseDate(await getCollection('albums'));

---

<MainLayout title="Ran Kirlian official website" wide>
  <h1 class="text-3xl font-semibold capitalize lg:text-4xl text-white">
    {siteConfig.title}
  </h1>

  <ReleasesLayout albums={albums} />
</MainLayout>
