---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { siteConfig } from "@config/site-config";
import MainLayout from "@layouts/MainLayout.astro";
import NewsItem from "@components/NewsItem.astro";
import NewsYearNav from "@components/NewsYearNav.astro";
import { archivedNews, newsYear, newsYears, sortNewsByDate } from "@utils/news";
import { pageTitle } from "@utils/seo";
import { pluralize } from "@utils/text";

export const getStaticPaths = (async () => {
  // Upcoming releases are shown on the news index, not in the year archives.
  const news = archivedNews(await getCollection("news"));
  const years = newsYears(news);
  return years.map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      years,
      items: sortNewsByDate(news.filter((item) => newsYear(item) === year)),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  year: number;
  years: number[];
  items: CollectionEntry<"news">[];
}

const { year, years, items } = Astro.props;
const itemCount = pluralize(items.length, "update");
---

<MainLayout
  title={pageTitle(`News from ${year}`)}
  description={`News from ${year}: ${itemCount} on ${siteConfig.artistName}'s releases, videos and other music activity.`}
>
  <h1 class="mt-6 mb-0 lg:mt-10">News from {year}</h1>

  <section aria-label={`News from ${year}`}>
    {items.map((item) => <NewsItem item={item} />)}
  </section>

  <NewsYearNav years={years} current={year} />
</MainLayout>
