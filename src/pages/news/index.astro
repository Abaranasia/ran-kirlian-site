---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import NewsItem from "@components/NewsItem.astro";
import NewsYearNav from "@components/NewsYearNav.astro";
import { newsYears, sortNewsByDate } from "@utils/news";

const LATEST_NEWS_COUNT = 10;

const news = await getCollection("news");
const latest = sortNewsByDate(news).slice(0, LATEST_NEWS_COUNT);
---

<MainLayout
  title="News | Ran Kirlian"
  description="Latest news and upcoming releases from ambient musician Ran Kirlian."
>
  <h1>News and upcoming releases</h1>

  <section aria-label="Latest news">
    {latest.map((item) => <NewsItem item={item} />)}
  </section>

  <NewsYearNav years={newsYears(news)} />
</MainLayout>
