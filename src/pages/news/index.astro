---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import NewsItem from "@components/NewsItem.astro";
import NewsYearNav from "@components/NewsYearNav.astro";
import { pageTitle } from "@utils/seo";
import { newsYears, sortNewsByDate } from "@utils/news";

const NEWS_PAGE_SIZE = 10;

const news = await getCollection("news");
const latest = sortNewsByDate(news).slice(0, NEWS_PAGE_SIZE);
---

<MainLayout
  title={pageTitle("News")}
  description="Latest news and upcoming releases from ambient musician Ran Kirlian."
>
  <h1 class="mt-6 mb-0 lg:mt-10">News and upcoming releases</h1>

  <section aria-label="Latest news">
    {latest.map((item) => <NewsItem item={item} />)}
  </section>

  <NewsYearNav years={newsYears(news)} />
</MainLayout>
