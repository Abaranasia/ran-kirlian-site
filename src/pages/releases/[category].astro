---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import ReleasesLayout from "@components/ReleasesLayout.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { releaseCategories, type ReleaseCategory } from "@config/release-categories";
import { sortByReleaseDate } from "@utils/releases";
import { pageTitle, yearRange } from "@utils/seo";
import { pluralize } from "@utils/text";

export const getStaticPaths = (() =>
  releaseCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: ReleaseCategory;
}

const { category } = Astro.props;
const albums = sortByReleaseDate(
  (await getCollection('albums')).filter(category.matches)
);
const years = yearRange(albums);
const releaseCount = pluralize(albums.length, "release");
const description = `${category.label} by ambient musician Ran Kirlian: ${releaseCount}${years ? ` from ${years}` : ""}, with tracklists, credits and reviews.`;
---

<MainLayout title={pageTitle(category.label)} description={description}>
  <h1 class="mt-6 mb-0 lg:mt-10">{category.label}</h1>

  <ReleasesLayout albums={albums} current={category.slug} />
</MainLayout>
