---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import ReleasesLayout from "@components/ReleasesLayout.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { releaseCategories, type ReleaseCategory } from "@config/release-categories";
import { sortByReleaseDate } from "@utils/releases";
import { yearRange } from "@utils/seo";

export const getStaticPaths = (() =>
  releaseCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: ReleaseCategory;
}

const { category } = Astro.props;
const albums = sortByReleaseDate(
  (await getCollection('albums')).filter(category.matches)
);
const releaseCount = `${albums.length} ${albums.length === 1 ? "release" : "releases"}`;
const description = `${category.label} by ambient musician Ran Kirlian: ${releaseCount} from ${yearRange(albums)}, with tracklists, credits and reviews.`;
---

<MainLayout title={`${category.label} | Ran Kirlian`} description={description}>
  <h1 class="mt-6 mb-0 lg:mt-10">{category.label}</h1>

  <ReleasesLayout albums={albums} current={category.slug} />
</MainLayout>
