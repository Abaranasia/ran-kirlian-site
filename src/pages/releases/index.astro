---
import { getCollection } from "astro:content";
import ReleasesLayout from "@components/ReleasesLayout.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { sortByReleaseDate } from "@utils/releases";
import { yearRange } from "@utils/seo";

const albums = sortByReleaseDate(await getCollection('albums'));
const description = `All ${albums.length} releases by Ran Kirlian, ${yearRange(albums)}: full-length albums, mini-albums and the Ethernautica and Many Futures series.`;
---

<MainLayout
  title="Releases | Ran Kirlian"
  description={description}
>
  <h1 class="text-3xl font-semibold lg:text-4xl text-white">
    Releases
  </h1>

  <ReleasesLayout albums={albums} />
</MainLayout>
