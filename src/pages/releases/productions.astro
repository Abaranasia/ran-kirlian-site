---
import { getCollection } from "astro:content";
import ProductionList from "@components/ProductionList.astro";
import ReleasesLayout from "@components/ReleasesLayout.astro";
import MainLayout from "@layouts/MainLayout.astro";
import { siteConfig } from "@config/site-config";
import { productionYearRange, sortProductionsByDate } from "@utils/productions";
import { pageTitle } from "@utils/seo";
import { pluralize } from "@utils/text";

const productions = sortProductionsByDate(await getCollection("productions"));
const years = productionYearRange(productions);
const albumCount = pluralize(productions.length, "album");
const description = `Albums by other artists produced, mixed or mastered by ambient musician ${siteConfig.artistName}: ${albumCount}${years ? ` from ${years}` : ""}.`;
---

<MainLayout title={pageTitle("Production & Mastering")} description={description}>
  <h1 class="mt-6 mb-0 lg:mt-10">Production &amp; Mastering</h1>
  <p class="mt-3 mb-0 text-muted">Production, mixing and mastering work on albums by other artists.</p>

  <ReleasesLayout current="productions">
    <ProductionList productions={productions} />
  </ReleasesLayout>
</MainLayout>
